rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(roomId) {
      return signedIn() && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
    }
    function isOwner(roomId) {
      return isMember(roomId) && get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId == request.auth.uid;
    }
    function validMember() {
      let data = request.resource.data;
      return data.keys().hasOnly(['name', 'times', 'submitted'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 30
        && data.submitted is bool && data.times is list && data.times.size() <= 14
        && data.times.hasOnly(['08:00', '09:00', '10:00', '11:00', '12:00', '13:00', '14:00', '15:00', '16:00', '17:00', '18:00', '19:00', '20:00', '21:00'])
        && data.times.toSet().size() == data.times.size();
    }
    match /rooms/{roomId} {
      // The random room ID acts as an invite. Listing all rooms is blocked.
      allow get: if signedIn();
      allow list, update, delete: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['title', 'date', 'ownerId', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 60
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == request.time;

      match /members/{memberId} {
        allow get: if isMember(roomId) || (signedIn() && memberId == request.auth.uid);
        allow list: if isMember(roomId);
        allow create: if signedIn() && memberId == request.auth.uid
          && exists(/databases/$(database)/documents/rooms/$(roomId))
          && validMember() && request.resource.data.submitted == false
          && request.resource.data.times.size() == 0;
        allow update: if isMember(roomId) && memberId == request.auth.uid
          && validMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['times', 'submitted']);
        allow delete: if false;
      }
      match /meeting/details {
        allow read: if isMember(roomId);
        allow create, update: if isOwner(roomId)
          && request.resource.data.keys().hasOnly(['time', 'link'])
          && request.resource.data.time in ['08:00', '09:00', '10:00', '11:00', '12:00', '13:00', '14:00', '15:00', '16:00', '17:00', '18:00', '19:00', '20:00', '21:00']
          && request.resource.data.link is string && request.resource.data.link.size() <= 300
          && request.resource.data.link.matches('^https://([a-zA-Z0-9-]+[.])*zoom[.]us/[^ ]*|^https://(discord[.]gg|discord[.]com|meet[.]google[.]com)/[^ ]*');
        allow delete: if false;
      }
    }
  }
}
